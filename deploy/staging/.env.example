# Public application URL
NEXT_PUBLIC_API_URL=https://api.staging.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com/api/v1

# Managed PostgreSQL
CORTEX_DB_DSN=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Managed Redis
CORTEX_REDIS_URL=rediss://:PASSWORD@HOST:6379/0

# Object storage
CORTEX_S3_ENDPOINT=https://s3.amazonaws.com
CORTEX_S3_BUCKET=cortex-nexus-staging
CORTEX_S3_REGION=ap-south-1
CORTEX_S3_ACCESS_KEY=<secret-manager-value>
CORTEX_S3_SECRET_KEY=<secret-manager-value>
CORTEX_S3_USE_PATH_STYLE=false

# Authentication / signing
CORTEX_JWT_SECRET=<secret-manager-value>

# Outbox relay
CORTEX_OUTBOX_PUBLISHER_ID=staging-outbox-relay
CORTEX_OUTBOX_SWEEP_INTERVAL_S=1.0
CORTEX_OUTBOX_BATCH_SIZE=100
CORTEX_OUTBOX_PUBLISHER_ENABLED=false

# The example deliberately contains no credentials. In cloud staging these
# values should be injected from the cloud secret manager, not committed.
