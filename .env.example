# Local development configuration for Cortex Nexus.
# Copy to .env (never commit .env). Every value here is a local placeholder:
# the credentials match infra/docker-compose.yml and protect nothing.

APP_ENV=development
APP_NAME=cortex-nexus-api
API_V1_PREFIX=/api/v1

# The API reads DATABASE_URL. The test suite reads TEST_DATABASE_URL and
# refuses to run against a database whose name does not end in "_test".
DATABASE_URL=postgresql+psycopg://nexus:nexus_dev@127.0.0.1:5432/cortex_nexus
TEST_DATABASE_URL=postgresql+psycopg://nexus:nexus_test@127.0.0.1:5433/cortex_nexus_test

LOG_LEVEL=INFO

# Upload limits enforced before and during parsing.
MAX_UPLOAD_SIZE_MB=20
MAX_IMPORT_ROWS=10000
MAX_IMPORT_COLUMNS=100
MAX_IMPORT_CELL_CHARS=2000
# Maximum simultaneous import previews per API worker process.
MAX_CONCURRENT_IMPORTS=1

# Development workspace context. The API serves exactly this workspace and
# refuses to start with this set when APP_ENV is not development or test.
NEXUS_DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# Reference date of the synthetic demo dataset. Tests and the seed checks use
# it instead of the machine clock.
NEXUS_DEMO_AS_OF=2026-11-19
