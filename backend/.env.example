# Cortex Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
CORTEX_ENV=dev
CORTEX_HOST=0.0.0.0
CORTEX_PORT=8000

# Database (PostgreSQL)
CORTEX_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/cortex

# Redis (for task queues / caching)
CORTEX_REDIS_URL=redis://localhost:6379/0

# S3-Compatible Storage (SeaweedFS local dev; AWS S3 works in deployment)
CORTEX_S3_ENDPOINT=http://localhost:8333
CORTEX_S3_BUCKET=cortex-uploads
CORTEX_S3_REGION=us-east-1
CORTEX_S3_ACCESS_KEY=minioadmin
CORTEX_S3_SECRET_KEY=minioadmin
CORTEX_S3_USE_PATH_STYLE=true

# Operational Intelligence model provider\n# Development uses the deterministic adapter unless a model gateway is configured.\n# Production/staging/pilot requires all four values below and will fail closed otherwise.\nCORTEX_LLM_PROVIDER=deterministic\nCORTEX_LLM_API_KEY=\nCORTEX_LLM_BASE_URL=https://api.openai.com/v1\nCORTEX_LLM_MODEL=\nCORTEX_LLM_TIMEOUT_S=30\nCORTEX_LLM_MAX_OUTPUT_TOKENS=2048\n\n# Production deployment secrets (set unique values; never use repository defaults)\n# CORTEX_JWT_SECRET=\n# CORTEX_DB_USER=cortex\n# CORTEX_DB_PASSWORD=\n# CORTEX_DB_NAME=cortex\n# CORTEX_REDIS_PASSWORD=\n\n# OpenTelemetry (optional)
OTEL_SERVICE_NAME=cortex-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus (optional)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus