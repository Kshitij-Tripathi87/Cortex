# Cortex Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
CORTEX_ENV=dev
CORTEX_HOST=0.0.0.0
CORTEX_PORT=8000

# Database (PostgreSQL)
CORTEX_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/cortex

# Redis (for task queues / caching)
CORTEX_REDIS_URL=redis://localhost:6379/0

# S3-Compatible Storage (SeaweedFS local dev; AWS S3 works in deployment)
CORTEX_S3_ENDPOINT=http://localhost:8333
CORTEX_S3_BUCKET=cortex-uploads
CORTEX_S3_REGION=us-east-1
CORTEX_S3_ACCESS_KEY=minioadmin
CORTEX_S3_SECRET_KEY=minioadmin
CORTEX_S3_USE_PATH_STYLE=true

# Operational Intelligence model provider
# Local development can use the deterministic adapter for smoke testing.
# Set these values to use a real model through an OpenAI-compatible gateway.
# Production/staging/pilot require a model name, API key and HTTPS base URL.
CORTEX_LLM_PROVIDER=deterministic
CORTEX_LLM_API_KEY=
CORTEX_LLM_BASE_URL=https://api.openai.com/v1
CORTEX_LLM_MODEL=
CORTEX_LLM_TIMEOUT_S=30
CORTEX_LLM_MAX_OUTPUT_TOKENS=2048

# Production deployment secrets (never commit populated values)
# CORTEX_JWT_SECRET=
# CORTEX_DB_USER=cortex
# CORTEX_DB_PASSWORD=  # use a URL-safe value, e.g. 64 hex characters
# CORTEX_DB_NAME=cortex
# CORTEX_REDIS_PASSWORD=
# CORTEX_S3_ACCESS_KEY=
# CORTEX_S3_SECRET_KEY=
# CORTEX_CORS_ALLOWED_ORIGINS=["https://app.example.com"]
# NEXT_PUBLIC_API_URL=https://api.example.com

# OpenTelemetry (optional)
OTEL_SERVICE_NAME=cortex-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus (optional)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus